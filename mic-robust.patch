+        // Если микрофон «включён», но звук не приходит (на телефонах после озвучки так бывает), перезапускаем захват.
+        private async void WatchdogAsync()
+        {
+            _watchdogRunning = true;
+            try
+            {
+                while (_listening && !_disposed)
+                {
+                    await Task.Delay(1500);
+                    if (!_listening || _disposed) break;
+
+                    double silentFor = _clock.Elapsed.TotalSeconds - _lastChunkAt;
+                    if (silentFor < 3.0) continue;
+
+                    Debug.LogWarning("[Sherpa] Звук с микрофона не приходит " + silentFor.ToString("F1", CultureInfo.InvariantCulture) +
+                        " с, перезапускаю захват.");
+                    try { _mic.StopCapture(); }
+                    catch (Exception e) { Debug.LogException(e); }
+
+                    if (!_mic.TryStartCapture())
+                    {
+                        RaiseError("Не удалось перезапустить микрофон.");
+                        break;
+                    }
+                    _lastChunkAt = _clock.Elapsed.TotalSeconds;
+                }
+            }
+            finally
+            {
+                _watchdogRunning = false;
+            }
         }
 
