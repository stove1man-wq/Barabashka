@@ -37,7 +37,19 @@ namespace Barabashka.Composition
             AgentActivityBus.Publish(AgentActivity.Speaking);
             try
             {
-                await _tts.SpeakAsync(text, languageCode, token);
+                // Если синтезатор «завис» и не сообщает об окончании, не оставляем микрофон выключенным навсегда.
+                Task speak = _tts.SpeakAsync(text, languageCode, token);
+                float maxSeconds = 8f + text.Length * 0.12f;
+                Task finished = await Task.WhenAny(speak, Task.Delay(TimeSpan.FromSeconds(maxSeconds)));
+                if (finished != speak)
+                {
+                    Debug.LogWarning("[Speech] Озвучка не завершилась за " + maxSeconds.ToString("F0") + " с, прерываю и включаю микрофон.");
+                    _tts.Stop();
+                }
+                else
+                {
+                    await speak; // пробросить отмену или ошибку
+                }
                 // Небольшая пауза: хвост звука из колонок не должен попасть в микрофон.
                 await Task.Delay(EchoTailMs);
             }
